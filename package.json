{
  "name": "convex-cms",
  "version": "0.0.2",
  "description": "A developer-first Convex Component for content management with flexible RBAC and AI-ready architecture",
  "type": "module",
  "workspaces": [
    "admin"
  ],
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./convex.config": "./dist/component/convex.config.js",
    "./types": {
      "types": "./dist/client/types.d.ts",
      "import": "./dist/client/types.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./_generated/component": "./dist/component/_generated/component.js",
    "./test": "./src/test.ts"
  },
  "files": [
    "dist",
    "src",
    "admin-dist",
    "README.md"
  ],
  "bin": {
    "convex-cms": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:component && npm run build:cli && npm run build:admin",
    "build:component": "tsc --project tsconfig.build.json",
    "build:cli": "tsc --project tsconfig.cli.json",
    "build:admin": "cd admin && npm run build && cp -r .output ../admin-dist",
    "dev": "npm-run-all2 --parallel dev:*",
    "dev:component": "npx convex codegen --component-dir ./src/component --watch",
    "dev:build": "tsc --project tsconfig.build.json --watch",
    "dev:example": "cd example && npx convex dev",
    "dev:watch": "chokidar 'src/**/*.ts' -c 'npm run build:component' --silent",
    "test": "vitest --once",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "alpha": "npm version prerelease --preid=alpha && npm publish --tag alpha",
    "release": "npm version patch && npm publish"
  },
  "keywords": [
    "convex",
    "cms",
    "headless-cms",
    "content-management",
    "convex-component"
  ],
  "author": "obkaro",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obkaro/convex-cms.git"
  },
  "bugs": {
    "url": "https://github.com/obkaro/convex-cms/issues"
  },
  "homepage": "https://github.com/obkaro/convex-cms#readme",
  "peerDependencies": {
    "@convex-dev/agent": "^0.3.0",
    "convex": "^1.17.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/agent": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@convex-dev/agent": "^0.3.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "chokidar-cli": "^3.0.0",
    "convex": "^1.31.6",
    "convex-test": "^0.0.41",
    "eslint": "^9.39.2",
    "npm-run-all2": "^8.0.4",
    "pkg-pr-new": "^0.0.62",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "convex-helpers": "^0.1.111",
    "open": "^11.0.0"
  }
}
