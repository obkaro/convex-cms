{
  "name": "@convex-cms/core",
  "version": "0.0.1",
  "description": "A developer-first Convex Component for content management with flexible RBAC and AI-ready architecture",
  "type": "module",
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./convex.config": "./dist/component/convex.config.js",
    "./types": {
      "types": "./dist/client/types.d.ts",
      "import": "./dist/client/types.js"
    },
    "./_generated/component": "./dist/component/_generated/component.js",
    "./test": "./src/test.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --project tsconfig.build.json",
    "dev": "npm-run-all --parallel dev:*",
    "dev:component": "npx convex codegen --component-dir ./src/component --watch",
    "dev:build": "tsc --project tsconfig.build.json --watch",
    "dev:example": "cd example && npx convex dev",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "convex",
    "cms",
    "headless-cms",
    "content-management",
    "convex-component"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "convex": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.11.0",
    "convex": "^1.17.0",
    "convex-test": "^0.0.35",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "convex-helpers": "^0.1.66"
  }
}
